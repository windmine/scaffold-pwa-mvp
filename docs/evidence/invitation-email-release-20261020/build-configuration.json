      "args": [
        "build",
        "-t",
        "australia-southeast1-docker.pkg.dev/geo-attendance-system-db9ca/cloud-run-source-deploy/geo-backend:invitation-fallback-20261020-2f861c5",
        "fallback"
      ]
    },
    {
      "name": "gcr.io/cloud-builders/docker",
