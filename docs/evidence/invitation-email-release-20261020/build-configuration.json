      ]
    },
    {
      "name": "gcr.io/cloud-builders/docker",
      "id": "candidate-registration-email-test.py",
      "args": [
        "run",
        "--rm",
        "--network",
        "none",
        "--read-only",
        "--tmpfs",
        "/tmp:rw,noexec,nosuid,size=256m",
        "-e",
        "APP_ENV=test",
        "-e",
        "AUTO_MIGRATE=false",
        "-e",
        "DATABASE_URL=sqlite://",
        "-e",
        "UPLOAD_DIR=/tmp/uploads",
        "-e",
