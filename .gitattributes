# Auto detect text files and perform LF normalization
* text=auto

# Printable artifacts must retain exact PDF bytes across platforms.
*.pdf binary

# Migration checksums are durable: Windows and Linux must ship identical bytes.
backend/migrations/versions/*.py text eol=lf

# New runtime-proof code is embedded as exact bytes; keep checkout/archive equal.
# Legacy verifier/contract scripts and all historical proof bytes are unchanged.
scripts/runtime_recovery.py text eol=lf
scripts/runtime-recovery-probe.py text eol=lf
scripts/runtime_recovery_inventory.py text eol=lf
scripts/runtime_recovery_build.py text eol=lf
scripts/prepare-runtime-recovery.ps1 text eol=lf
scripts/check-runtime-recovery.ps1 text eol=lf
scripts/check-runtime-recovery-test.py text eol=lf
scripts/check-runtime-recovery-inventory-test.py text eol=lf
scripts/check-runtime-recovery-build-test.py text eol=lf
scripts/check-runtime-recovery-integration-test.ps1 text eol=lf
scripts/check-prepare-runtime-recovery-test.ps1 text eol=lf

# Preserve this hash-bound recipient-confirmed release proof exactly.
docs/evidence/alert-delivery-diagnosis-2026-10-12.json -text

# Preserve captured line endings and trailing blank lines in the hash-bound journal.
docs/evidence/report-corrections-release-20261023/** -text whitespace=blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol

# Preserve exact safe Refresh release proof bytes.
docs/evidence/safe-refresh-release-20261027/** -text whitespace=blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol

# Preserve captured bytes in the installer/guide release proof and its hashes.
docs/evidence/install-guide-release-20261104/** -text whitespace=blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
# Captured tool logs include their original trailing spaces and blank lines.
docs/evidence/install-guide-release-20261104/*.txt -text whitespace=-blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
